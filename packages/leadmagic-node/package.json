{
  "name": "leadmagic-node",
  "version": "0.0.0",
  "private": true,
  "description": "LeadMagic API client for Node.js and other server runtimes: every documented endpoint, typed, with schemas for Zod and a consistent error contract.",
  "keywords": [
    "leadmagic",
    "email finder",
    "email validation",
    "b2b data",
    "enrichment",
    "api client",
    "sdk"
  ],
  "homepage": "https://leadmagic.io/docs/sdk",
  "bugs": "https://github.com/LeadMagic/leadmagic-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeadMagic/leadmagic-js.git",
    "directory": "packages/leadmagic-node"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "default": "./dist/zod/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only && size-limit",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "test": "vitest run",
    "test:contract": "LEADMAGIC_CONTRACT=1 vitest run test/contract.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^24.0.0",
    "openapi-typescript": "7.13.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "14 kB"
    }
  ]
}
