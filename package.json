{
  "name": "leadmagic-js",
  "private": true,
  "scripts": {
    "build": "pnpm -F leadmagic -F leadmagic-node build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm generate:check && pnpm typecheck && pnpm test && pnpm check:package",
    "check:package": "pnpm -F leadmagic -F leadmagic-node check:package",
    "generate:check": "pnpm -F leadmagic-node generate:check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "registry:build": "node scripts/build-registry.mjs",
    "release": "pnpm build && changeset publish",
    "test": "pnpm -F leadmagic -F leadmagic-node test",
    "test:contract": "pnpm -F leadmagic -F leadmagic-node test:contract",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@changesets/cli": "^3.0.3",
    "ultracite": "8.3.1"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
